{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missioncontrol.wallyweb.com/schemas/mission-agent-replacement-bootstrap-authorization-v1.json",
  "title": "Operator-mediated Mission Agent replacement bootstrap authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "authorizationId",
    "agentId",
    "hostIdentity",
    "workspaceId",
    "repositoryId",
    "repositoryFingerprint",
    "currentVersion",
    "currentArtifactSha256",
    "targetVersion",
    "targetArtifactSha256",
    "targetArtifactByteLength",
    "targetManifestSha256",
    "targetSignatureSha256",
    "targetSigningKeyId",
    "targetPublicKeyFingerprint",
    "requiredNodeVersion",
    "approvalId",
    "operatorIdentity",
    "approvedBy",
    "approvedAt",
    "expiresAt",
    "maximumExecutionCount",
    "rollbackVersion",
    "rollbackArtifactSha256",
    "reason",
    "legacyCryptographicContinuity",
    "evidenceReferences"
