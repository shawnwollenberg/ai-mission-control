{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consensus-real-provider-acceptance-contract/3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "validator_registry_version",
    "scope",
    "runtime_mode",
    "production_access",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": "consensus-real-provider-acceptance-contract/3" },
    "registry_version": { "const": "consensus-acceptance-executable-registry/1" },
    "validator_registry_version": { "const": "consensus-acceptance-validator-registry/1" },
    "scope": { "const": "disposable_consensus_real_provider_acceptance" },
    "runtime_mode": { "const": "disposable_acceptance" },
    "production_access": { "const": false },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{2,159}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "category",
        "requirement_id",
        "mandatory",
        "applicable_roles",
        "applicable_providers",
        "applicable_models",
        "applicable_profiles",
        "protected_action",
        "expected_failure_code",
        "evidence_schema",
        "implementation_module",
        "bound_source_modules",
        "execution_phase",
        "lifecycle_phase",
        "implementation_reference",
        "validator_id",
        "validator_configuration_identity",
        "validator_identity",
        "required_evidence_fields",
        "pass_criteria_id",
        "implementation_identity",
        "timeout_ms"
      ],
      "properties": {
        "step_id": { "$ref": "#/$defs/id" },
        "category": {
          "enum": [
            "preflight",
            "workflow",
            "authority",
            "adversarial",
            "recovery",
            "isolation",
            "replay",
            "review",
            "cleanup"
          ]
        },
        "requirement_id": { "type": "string", "pattern": "^REQ-[A-F0-9]{16}$" },
        "mandatory": { "const": true },
        "applicable_roles": { "$ref": "#/$defs/strings" },
        "applicable_providers": { "$ref": "#/$defs/strings" },
        "applicable_models": { "$ref": "#/$defs/strings" },
        "applicable_profiles": { "$ref": "#/$defs/strings" },
        "protected_action": { "type": ["string", "null"] },
        "expected_failure_code": { "type": ["string", "null"] },
        "evidence_schema": { "type": "string", "minLength": 3 },
        "implementation_module": { "const": "scripts/consensus-real-acceptance-steps.ts" },
        "bound_source_modules": { "$ref": "#/$defs/strings", "minItems": 1 },
        "execution_phase": { "enum": ["harness", "post_run"] },
        "lifecycle_phase": { "enum": ["pre_review", "review", "cleanup", "post_cleanup"] },
        "implementation_reference": {
          "type": "string",
          "pattern": "^acceptanceExecutableRegistry:[a-z][a-z0-9_.]{2,159}$"
        },
        "validator_id": { "type": "string", "minLength": 8 },
        "validator_configuration_identity": { "$ref": "#/$defs/hash" },
        "validator_identity": { "$ref": "#/$defs/hash" },
        "required_evidence_fields": { "$ref": "#/$defs/strings", "minItems": 1 },
        "pass_criteria_id": { "type": "string", "minLength": 8 },
        "implementation_identity": { "$ref": "#/$defs/hash" },
        "timeout_ms": { "type": "integer", "minimum": 0, "maximum": 3600000 }
      }
    }
  }
}
