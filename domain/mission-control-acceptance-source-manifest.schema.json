{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission-control-acceptance-source-manifest/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "sourceBase", "includedRoots", "includedFiles", "excludedFiles", "files"],
  "properties": {
    "schemaVersion": { "const": "mission-control-acceptance-source-manifest/1" },
    "scope": { "const": "disposable_consensus_acceptance_security_boundary" },
    "sourceBase": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "includedRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "includedFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "excludedFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/\\[\\]-]*$" },
      "additionalProperties": { "$ref": "#/$defs/hash" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/\\[\\]-]*$" }
  }
}
