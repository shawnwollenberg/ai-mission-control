{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository-authority/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "readAllowed",
    "isolatedWorktreeWriteAllowed",
    "missionAgentLocalCommitAllowed",
    "providerDirectCommitAllowed",
    "pushAllowed",
    "pullRequestAllowed",
    "mergeAllowed",
    "publicationAllowed",
    "deploymentAllowed",
    "infrastructureMutationAllowed",
    "implementationAgentIds"
  ],
  "properties": {
    "schemaVersion": { "const": "repository-authority/1" },
    "profile": { "const": "disposable_local_implementation/1" },
    "readAllowed": { "const": true },
    "isolatedWorktreeWriteAllowed": { "const": true },
    "missionAgentLocalCommitAllowed": { "const": true },
    "providerDirectCommitAllowed": { "const": false },
    "pushAllowed": { "const": false },
    "pullRequestAllowed": { "const": false },
    "mergeAllowed": { "const": false },
    "publicationAllowed": { "const": false },
    "deploymentAllowed": { "const": false },
    "infrastructureMutationAllowed": { "const": false },
    "implementationAgentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    }
  }
}
