    "test:integration": "node --import tsx --test --test-concurrency=1 tests/*.integration.test.mjs",
    "test:repository-identity": "node --import tsx --test tests/repository-identity.test.mjs tests/repository-identity.integration.test.mjs",
    "test:release-authority": "node --import tsx --test tests/release-authority-v2.test.mjs",
    "test:mission-agent-070": "node --import tsx --test tests/mission-agent-070.test.mjs",
    "test:mission-agent-071": "node --import tsx --test tests/mission-agent-071.test.mjs",
    "test:mission-agent-072": "node --import tsx --test tests/mission-agent-072.test.mjs tests/release-authority-v3.test.mjs",
    "test:e2e": "node --test tests/*.e2e.test.mjs",
