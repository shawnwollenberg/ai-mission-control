  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@aws-sdk/client-kms": "^3.1095.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-sts": "^3.1095.0",
    "@aws-sdk/lib-dynamodb": "^3.1090.0",
    "@openai/codex": "^0.144.6",
    "@openai/codex-sdk": "^0.151.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "16.2.11",
    "openai": "^7.8.0",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "aws-cdk": "^2.1132.0",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  }
