{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "preinstall": "node scripts/require-node22.mjs",
    "runtime:check": "node scripts/require-node22.mjs",
    "mission-agent:release:build": "tsx scripts/mission-agent-release-build.ts",
    "mission-agent:build:070": "node scripts/build-mission-agent-070.mjs",
    "mission-agent:build:071": "node scripts/build-mission-agent-071.mjs",
    "mission-agent:build:072": "node scripts/build-mission-agent-072.mjs",
    "mission-agent:build:073": "node scripts/build-mission-agent-073.mjs",
    "mission-agent:build:080": "node scripts/build-mission-agent-080.mjs",
