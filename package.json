    "worker:v2:stop": "tsx scripts/v2-worker-control.ts stop",
    "worker:v2:status": "tsx scripts/v2-worker-control.ts status",
    "worker:v2:reconnect": "tsx scripts/v2-worker-control.ts reconnect",
    "mc:v2:handoff": "tsx scripts/v2-handoff.ts",
    "bridge:hermes": "tsx agents/hermes/bridge.ts",
    "execution:run-codex": "tsx scripts/run-codex-execution.ts",
