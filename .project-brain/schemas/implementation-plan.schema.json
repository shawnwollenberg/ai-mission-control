{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-plan.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "objective",
    "repository_sha",
    "steps",
    "risks",
    "validation",
    "evidence"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^2\\." },
    "artifact_type": { "const": "implementation-plan" },
    "objective": { "type": "string", "minLength": 1 },
    "repository_sha": { "type": "string", "minLength": 7 },
    "steps": { "type": "array", "minItems": 1 },
    "risks": { "type": "array" },
    "validation": { "type": "array" },
    "evidence": { "type": "array", "minItems": 1 }
  }
}
