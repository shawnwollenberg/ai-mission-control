{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposed-learning.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "id",
    "title",
    "scope",
    "status",
    "claim",
    "evidence",
    "confidence",
    "observed_at",
    "recommended_future_behavior",
    "proposed_by",
    "source_mission",
    "suggested_disposition",
    "contradiction_check",
    "duplicate_check"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^2\\." },
    "artifact_type": { "const": "proposed-learning" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "const": "proposed" },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "reference"],
        "properties": {
          "kind": { "enum": ["file", "test", "review", "mission", "command", "artifact"] },
          "reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "observed_at": { "type": "string", "minLength": 1 },
    "recommended_future_behavior": { "type": "string", "minLength": 1 },
    "proposed_by": { "type": "string", "minLength": 1 },
    "source_mission": { "type": "string", "minLength": 1 },
    "proposal_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "suggested_disposition": { "type": "string", "minLength": 1 },
    "contradiction_check": { "type": "string", "minLength": 1 },
    "duplicate_check": { "type": "string", "minLength": 1 }
  }
}
