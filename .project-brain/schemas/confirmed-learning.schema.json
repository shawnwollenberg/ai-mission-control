{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confirmed-learning.schema.json",
  "type": "object",
  "required": ["schema_version", "artifact_type", "id", "title", "scope", "status", "claim", "evidence", "confidence", "observed_at", "verified_at", "superseded_by", "recommended_future_behavior", "proposed_by", "reviewed_by", "source_mission"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^2\\."},
    "artifact_type": {"const": "confirmed-learning"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["confirmed", "encoded", "retained", "stale", "superseded"]},
    "claim": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "reference"],
        "properties": {
          "kind": {"enum": ["file", "test", "review", "mission", "command", "artifact"]},
          "reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {
      "oneOf": [
        {"enum": ["low", "medium", "high"]},
        {
          "type": "object",
          "required": ["score"],
          "properties": {"score": {"type": "number", "minimum": 0, "maximum": 1}}
        }
      ]
    },
    "validation": {
      "type": "object",
      "required": ["observed", "reused", "contradicted", "superseded"],
      "properties": {
        "observed": {"type": "integer", "minimum": 0},
        "reused": {"type": "integer", "minimum": 0},
        "contradicted": {"type": "integer", "minimum": 0},
        "superseded": {"type": "boolean"}
      }
    },
    "last_verified": {"type": "string", "format": "date"},
    "observed_at": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "minLength": 1},
    "superseded_by": {"type": ["string", "null"]},
    "recommended_future_behavior": {"type": "string", "minLength": 1},
    "proposed_by": {"type": "string", "minLength": 1},
    "reviewed_by": {"type": "string", "minLength": 1},
    "source_mission": {"type": "string", "minLength": 1}
  }
}
