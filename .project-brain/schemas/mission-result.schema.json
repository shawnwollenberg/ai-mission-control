{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission-result.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_type", "id", "objective", "agent", "role", "status", "start_sha", "end_sha", "acceptance_criteria", "acceptance_outcome", "files_changed", "checks", "review_cycles", "findings_and_resolutions", "risks", "evidence", "follow_ups", "completed_at"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^2\\."},
    "artifact_type": {"const": "mission-result"},
    "id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed", "blocked", "cancelled"]},
    "start_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "end_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_outcome": {"type": "string", "minLength": 1},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "result"], "properties": {"command": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1}}}},
    "review_cycles": {"type": "array", "items": {"type": "string"}},
    "findings_and_resolutions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "reference"], "properties": {"kind": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}}}},
    "follow_ups": {"type": "array", "items": {"type": "string"}},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
