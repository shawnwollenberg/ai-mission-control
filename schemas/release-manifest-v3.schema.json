{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-control.wallyweb.com/schemas/release-manifest-v3.schema.json",
  "title": "Mission Agent Release Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactByteLength",
    "artifactName",
    "artifactSha256",
    "build",
    "canonicalizationVersion",
    "compatibility",
    "createdAt",
    "expiresAt",
    "manifestVersion",
    "platform",
    "provenance",
    "publicKeyFingerprint",
    "releaseAuthorityVersion",
    "releaseVersion",
    "signingKeyId"
  ],
  "properties": {
    "artifactByteLength": { "type": "integer", "minimum": 1 },
    "artifactName": { "type": "string", "pattern": "^mission-agent-[0-9]+\\.[0-9]+\\.[0-9]+\\.mjs$" },
    "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildId", "sourceCommit"],
      "properties": {
        "buildId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "canonicalizationVersion": { "const": "release-manifest-json-v3" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationProtocolVersion", "identityProtocolVersion", "minimumMissionControlVersion"],
      "properties": {
        "activationProtocolVersion": { "const": "1" },
        "identityProtocolVersion": { "const": "2" },
        "minimumMissionControlVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "manifestVersion": { "const": "3" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "artifactFormat", "operatingSystem", "runtime", "runtimeMajorVersion"],
      "properties": {
        "architecture": { "const": "universal" },
        "artifactFormat": { "const": "esm" },
        "operatingSystem": { "const": "darwin-linux" },
        "runtime": { "const": "node" },
        "runtimeMajorVersion": { "const": 22 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builderSha256",
        "containerImageDigest",
        "manifestSchemaSha256",
        "nodeVersion",
        "packageLockSha256",
        "reproducibilityEvidenceSha256"
      ],
      "properties": {
        "builderSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "containerImageDigest": { "type": "string", "pattern": "^node@sha256:[a-f0-9]{64}$" },
        "manifestSchemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "nodeVersion": { "const": "22.22.0" },
        "packageLockSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reproducibilityEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "publicKeyFingerprint": {
      "type": "string",
      "pattern": "^ed25519-spki-sha256:[a-f0-9]{64}$"
    },
    "releaseAuthorityVersion": { "const": "v2" },
    "releaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "signingKeyId": { "type": "string", "pattern": "^mission-agent-release-[0-9]{4}-[0-9]{2}$" }
  }
}
